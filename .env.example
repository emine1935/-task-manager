# ============================================
# Bu dosya bir ŞABLONDUR. Gerçek değerlerle
# doldurup ".env" adıyla kaydedin.
# ".env" dosyası ASLA git'e commit edilmemelidir.
# ============================================

# Uygulama ortamı: development | production
NODE_ENV=development

# Uygulamanın dışa açacağı port
APP_PORT=3000

# --- Veritabanı Ayarları (PostgreSQL, Docker DIŞINDA kurulu) ---

# Container İÇİNDEN host makinedeki veritabanına erişim adresi.
# Linux/Mac/Windows Docker Desktop'ta genelde: host.docker.internal
# (Sunucuda farklıysa, sunucunun gerçek dahili IP'sini yazın.)
DB_HOST=host.docker.internal

# Host makine üzerinde DOĞRUDAN çalışan script'ler (örn. migrate.sh) için
# kullanılacak adres. Genelde 127.0.0.1 / localhost.
DB_HOST_LOCAL=127.0.0.1

DB_PORT=5432
DB_NAME=app_db
DB_USER=app_user
DB_PASSWORD=changeme

# --- Sunucuya özel ayarlar (deploy.sh ve CI/CD için) ---
# Bu bölüm sadece SUNUCUDAKİ .env dosyasında doldurulur, local'de gerek yok.
SERVER_IP=203.0.113.10
SERVER_SSH_USER=deploy
SERVER_APP_DIR=/opt/task-manager
